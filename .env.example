# Bearer token gating /api/knowledge — the AI assistant's knowledge bundle endpoint.
# Required by app/api/knowledge/route.ts. Without it, the endpoint returns 500.
# Generate with: openssl rand -hex 24
KNOWLEDGE_BUNDLE_TOKEN=

# n8n production webhook URL the chat proxy (app/api/chat/route.ts) forwards to.
# Get it from the n8n workflow once it's set to Active (Production URL, not webhook-test).
N8N_CHAT_WEBHOOK_URL=
