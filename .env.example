# n8n production webhook URL the chat proxy (app/api/chat/route.ts) forwards to.
# Get it from the n8n workflow once it's set to Active (Production URL, not webhook-test).
N8N_CHAT_WEBHOOK_URL=

# n8n webhook that logs anonymous PDF downloads (app/api/cv/[locale] → recordDownload).
# Receives { downloadId, ts, locale, referer, country, region, city, userAgent }.
# Leave empty in dev — downloads are logged to the console instead.
N8N_DOWNLOAD_WEBHOOK_URL=

# n8n webhook that logs CV opens (app/api/track ← OpenTracker, fired when a
# recruiter follows the PDF's /r/<downloadId> link). Receives
# { downloadId, ts, referer, country, region, city, userAgent }; n8n joins
# downloadId→company in the cv-downloads sheet to surface who opened the CV.
# Leave empty in dev — opens are logged to the console instead.
N8N_OPEN_WEBHOOK_URL=

# n8n webhook that logs EVERY CV visit (PDF or organic — VisitTracker fires on
# every page render). app/api/visit ← VisitTracker. Receives
# { ts, locale, referrer, country, region, city, userAgent }; n8n notifies the
# cv-opens-all Slack channel. PDF arrivals also hit N8N_OPEN_WEBHOOK_URL (with
# company); this is the all-visits firehose.
# Leave empty in dev — visits are logged to the console instead.
N8N_VISIT_WEBHOOK_URL=
