# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private CV construction notes (per-project inventories of bullet candidates,
# senior/baseline categorization, internal evaluations) — kept local only
/content/data-inventories/

# public-safe curated inventories fed to the CV chat bot — kept local,
# pasted into n8n by hand (not needed in the repo / prod build)
/content/data-inventories-public/

# n8n workflow exports (ask-cv etc.) — kept local; the JSON embeds the inline
# knowledge bundle (curated inventories) and is a deployment artifact, not source
/n8n/
